# Server
PORT=3000

# Telegram (bot is shared across all registered users)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Per-user webhook_secret / telegram_chat_id now live in the `users`
# table (see supabase/schema.sql) — register users with scripts/add-user.js

# Supabase
# Get from: https://supabase.com → Project → Settings → API
SUPABASE_URL=your_project_url
SUPABASE_ANON_KEY=your_anon_public_key

# Settings
DAILY_SUMMARY_CRON=0 23 * * *
TIMEZONE=Asia/Bangkok
