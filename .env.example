# Server
PORT=3000
WEBHOOK_SECRET=your_secret_token_here


# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# LINE Messaging API (LINE Notify discontinued March 2025)
# Get from: https://developers.line.biz/console → Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_USER_ID=your_line_user_id

# Supabase (replaces local file storage)
# Get from: https://supabase.com → Project → Settings → API
SUPABASE_URL=your_project_url
SUPABASE_ANON_KEY=your_anon_public_key

# Settings
DAILY_SUMMARY_CRON=0 22 * * *
TIMEZONE=Asia/Bangkok
